<?php
/**
 * app_local.php.example
 *
 * Copy to config/app_local.php and update values for your local environment.
 * This file is gitignored — never commit real credentials.
 */
return [
    'debug' => (bool)env('APP_DEBUG', true),

    // --- HTTP Basic Authentication (M1) ---
    // Required environment variables for BasicAuthMiddleware.
    // Set these in your Docker Compose, ECS task definition, or .env file.
    // Never commit real values — this file is an example only.
    //
    //   APP_AUTH_USER      — username accepted by the application (e.g. "ops")
    //   APP_AUTH_PASSWORD  — password accepted by the application (use a strong random value)
    //
    // If either variable is unset, ALL requests (except GET /health) will be
    // denied with HTTP 401 — fail-closed design is intentional.

    'Security' => [
        'salt' => env('SECURITY_SALT', '__CHANGE_ME__'),
    ],

    'Datasources' => [
        'default' => [
            'host'     => env('DB_HOST', '127.0.0.1'),
            'port'     => env('DB_PORT', '3306'),
            'username' => env('DB_USERNAME', 'sdi_user'),
            'password' => env('DB_PASSWORD', 'secret'),
            'database' => env('DB_NAME', 'sdi_ops_monitor'),
        ],
        'test' => [
            'host'     => env('DB_HOST', '127.0.0.1'),
            'port'     => env('DB_PORT', '3306'),
            'username' => env('DB_USERNAME', 'sdi_user'),
            'password' => env('DB_PASSWORD', 'secret'),
            'database' => env('DB_NAME', 'sdi_ops_monitor_test'),
        ],
    ],

    // --- AWS SQS Scheduler (M2) ---
    // Set via environment variables — never hardcode credentials here.
    // The SqsPollCommand reads these at runtime; no PHP config key is needed.
    //
    //   AWS_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue-name>
    //   AWS_REGION=eu-west-1
    //   AWS_ACCESS_KEY_ID=<from IAM role or env>      (omit when using instance role)
    //   AWS_SECRET_ACCESS_KEY=<from IAM role or env>  (omit when using instance role)
    //   AWS_SESSION_TOKEN=<from STS for temporary credentials> (optional)
    //
    // Production: inject via ECS task definition environment or EC2 instance role.
    // Local dev:  export the variables in your shell before running bin/cake sqs_poll.
    // Cron example (every 60 s):
    //   * * * * * www-data /var/www/html/bin/cake sqs_poll >> /var/log/sqs_poll.log 2>&1

    'EmailTransport' => [
        'default' => [
            'host' => 'localhost',
        ],
    ],

    // Structured JSON logging — compatible with Kibana / ELK stack.
    // Each log entry is emitted as a single-line JSON object. Fields include:
    //   date, level, message, and any context array passed to Log::write().
    // Consumers should inject the 'correlation_id' key in the context array
    // (available via $request->getAttribute('correlation_id')) so that all
    // records belonging to one HTTP transaction are filterable in Kibana.
    //
    // NOTE: do NOT edit config/app.php — only override in app_local.php.
    'Log' => [
        'default' => [
            'className' => \Cake\Log\Engine\FileLog::class,
            'path'      => LOGS,
            'file'      => 'app',
            'scopes'    => false,
            'levels'    => ['notice', 'info', 'debug'],
            'formatter' => [
                'className' => \Cake\Log\Formatter\JsonFormatter::class,
                'includeDate' => true,
            ],
        ],
        'error' => [
            'className' => \Cake\Log\Engine\FileLog::class,
            'path'      => LOGS,
            'file'      => 'error',
            'scopes'    => false,
            'levels'    => ['warning', 'error', 'critical', 'alert', 'emergency'],
            'formatter' => [
                'className' => \Cake\Log\Formatter\JsonFormatter::class,
                'includeDate' => true,
            ],
        ],
    ],

    // ── Alert thresholds ────────────────────────────────────────────────
    //
    // Overrides AlertsService::DEFAULT_THRESHOLDS per metric. A metric listed
    // here replaces its built-in rule-set entirely; metrics not listed keep
    // their defaults.
    //
    // Rules default to firing when the value climbs to or above the threshold.
    // Declare 'direction' => 'below' for countdown metrics, where the danger is
    // the number getting smaller — days left before the signing certificate
    // expires being the case that matters here.
    //
    // The defaults are documented with their reasoning in AlertsService. Two
    // are worth revisiting on every deployment:
    //
    //   invoices_pending — volume-dependent. 500 pending is an emergency for a
    //     studio filing thirty invoices a day and an ordinary Monday for a
    //     utility filing fifty thousand. Size it against real traffic.
    //
    //   signing_cert_expiry_days — depends on how long your certification
    //     authority takes to reissue. Lengthen the high threshold if renewal
    //     needs procurement approval.
    //
    // Uncomment and adjust as needed:
    //
    // 'Thresholds' => [
    //     'sdi_receipt_lag_minutes' => [
    //         ['threshold' => 30.0, 'severity' => 'high'],
    //         ['threshold' => 120.0, 'severity' => 'critical'],
    //     ],
    //     'sdi_rejection_rate' => [
    //         ['threshold' => 5.0, 'severity' => 'high'],
    //         ['threshold' => 15.0, 'severity' => 'critical'],
    //     ],
    //     'invoices_pending' => [
    //         ['threshold' => 500.0, 'severity' => 'high'],
    //         ['threshold' => 2000.0, 'severity' => 'critical'],
    //     ],
    //     'signing_cert_expiry_days' => [
    //         ['threshold' => 30.0, 'severity' => 'high', 'direction' => 'below'],
    //         ['threshold' => 7.0, 'severity' => 'critical', 'direction' => 'below'],
    //     ],
    // ],
];
