  "assumptions": [
    {"id": "A1", "text": "MySQL 8.0 disponibile e raggiungibile all'avvio"},
    {"id": "A2", "text": "AWS credentials iniettate via env vars — non hardcoded"},
    {"id": "A3", "text": "In M0 non c'è autenticazione — accesso libero ad API e dashboard"},
    {"id": "A4", "text": "config/app_local.php copiato da .example e configurato dall'operatore prima dell'esecuzione"},
    {"id": "A5", "text": "CakePHP 5 non richiede config/bootstrap.php separato — quello esistente è sufficiente"},
    {"id": "A6", "text": "Campo tags in tabella metrics è tipo JSON o TEXT con serializzazione — verificare migration"},
    {"id": "A7", "text": "Se alerts è vuota, dashboard mostra overallStatus green senza errori"},
    {"id": "A8", "text": "MetricsFixture necessaria solo se i test verificano persistenza via SELECT"},
    {"id": "A9", "text": "OPENROUTER_API_KEY assente → fallback deterministico attivo — nessun errore esposto; demo funziona offline"},
    {"id": "A10", "text": "GitHub Actions abilitato sul repository — workflow ci.yml non richiede configurazione aggiuntiva"},
    {"id": "A_M4_1", "text": "Account AWS free tier disponibile con permessi EB, EC2, S3, IAM, RDS, SQS, CloudWatch"},
    {"id": "A_M4_2", "text": "AWS credentials configurate in ~/.aws/credentials lato operatore (non nel repo)"},
    {"id": "A_M4_3", "text": "EB CLI installato localmente (pip install awsebcli)"},
    {"id": "A_M4_4", "text": "Platform target: PHP 8.2 running on 64bit Amazon Linux 2023 (no Docker — deploy diretto)"},
    {"id": "A_M4_5", "text": "Instance type: t3.micro (free tier eligible) — single-instance environment"},
    {"id": "A_M4_6", "text": "Le variabili sensibili vengono impostate via EB console (Environment properties) — non via .ebextensions"},
    {"id": "A_M4_7", "text": "CakePHP 5 legge DATABASE_URL via ConnectionManager — config/app.php deve essere aggiornato"},
    {"id": "A_M4_8", "text": "RDS istanza: db.t3.micro, MySQL 8.0, storage 20GB gp2 (free tier limits)"},
    {"id": "A_M4_9", "text": "La VPC default è sufficiente per collegare EB e RDS; no VPC custom richiesta"},
    {"id": "A_M4_10", "text": "CakePHP 5 ConnectionManager supporta DATABASE_URL — da verificare; fallback a singole env vars se necessario"},
    {"id": "A_M4_11", "text": "I log CakePHP sono scritti in logs/error.log e logs/debug.log — path standard CakePHP 5"},
    {"id": "A_M4_12", "text": "CloudWatch agent disponibile su Amazon Linux 2023 (preinstallato su EB PHP platform)"},
    {"id": "A_M4_13", "text": "Costo CloudWatch free tier: 5GB log ingest/mese, 10 allarmi — sufficiente per M4"},
    {"id": "A_M4_14", "text": "Free tier EB single-instance → no ALB; SSL termination su nginx/apache dell'istanza EC2"},
    {"id": "A_M4_15", "text": "Per M4: self-signed cert accettabile; produzione richiederà cert firmato da CA GovWay-compatible"},
    {"id": "A_M4_16", "text": "GovWay mTLS client cert è post-M4; M4 configura solo SSL server-side e headers proxy"},
    {"id": "A_M4_17", "text": "Coda SQS già creata dall'operatore prima del deploy (standard, non FIFO)"},
    {"id": "A_M4_18", "text": "IAM Role dell'istanza EC2 EB ha permessi sqs:ReceiveMessage, sqs:DeleteMessage sulla coda configurata"},
    {"id": "A_M4_19", "text": "Cron via .ebextensions ogni minuto è sufficiente per M4; EB worker tier è fuori scope"},
