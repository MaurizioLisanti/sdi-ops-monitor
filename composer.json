{
    "name": "sdi/sdi-ops-monitor",
    "description": "SDI Ops Monitor — CakePHP 5 operational monitoring platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0",
        "cakephp/migrations": "^5.0",
        "cakephp/bake": "^3.0",
        "aws/aws-sdk-php": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "cakephp/cakephp-codesniffer": "^5.3",
        "phpstan/phpstan": "^2.2",
        "phpstan/extension-installer": "^1.4",
        "cakedc/cakephp-phpstan": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/ tests/",
        "cs-fix": "phpcbf --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/ tests/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
