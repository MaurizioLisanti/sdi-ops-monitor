# sdi-ops-monitor — Environment Variables
# Copy to .env and fill in real values before running.

# ── App ──────────────────────────────────────────────────────
APP_NAME="SDI Ops Monitor"
APP_ENV=development          # development | production
APP_DEBUG=true
APP_URL=http://localhost:8080
SECURITY_SALT=__GENERATE_RANDOM_64_CHAR_STRING__

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdi_ops_monitor
DB_USERNAME=sdi_user
DB_PASSWORD=secret

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=__DA_VERIFICARE__
AWS_SECRET_ACCESS_KEY=__DA_VERIFICARE__
AWS_SNS_TOPIC_ARN=__DA_VERIFICARE__
AWS_SQS_QUEUE_URL=__DA_VERIFICARE__

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug              # debug | info | warning | error
LOG_FORMAT=json              # json | text
