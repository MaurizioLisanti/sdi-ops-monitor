# sdi-ops-monitor — Environment Variables
#
# Copy to .env (local development) or inject via `eb setenv` / the Elastic
# Beanstalk console (production). Never commit a filled-in .env.
#
# Variables marked REQUIRED must be set or the application will refuse to
# start / will deny every request (fail-closed design).

# ── App ──────────────────────────────────────────────────────
APP_NAME="SDI Ops Monitor"
APP_ENV=development                  # development | production
APP_DEBUG=true                       # MUST be false in production
APP_URL=http://localhost:8765

# REQUIRED — CakePHP security salt. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SECURITY_SALT=__CHANGE_ME_64_HEX_CHARS__

# ── Authentication (BasicAuthMiddleware) ─────────────────────
# REQUIRED — every route except /health is denied when these are empty.
# See src/Middleware/BasicAuthMiddleware.php (fail-closed by design).
APP_AUTH_USER=__CHANGE_ME__
APP_AUTH_PASSWORD=__CHANGE_ME__

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sdi_ops_monitor
DB_USERNAME=sdi_user
DB_PASSWORD=__CHANGE_ME__

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<account-id>/<queue-name>
AWS_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:<account-id>:<topic-name>

# Credentials: in production on Elastic Beanstalk the AWS SDK resolves
# credentials from the EC2 instance IAM role — do NOT set static keys here.
# The instance profile needs: sqs:ReceiveMessage, sqs:DeleteMessage,
# sqs:GetQueueAttributes, logs:PutLogEvents.
#
# Local development only (prefer `aws configure` / SSO over inline keys):
# AWS_ACCESS_KEY_ID=__CHANGE_ME__
# AWS_SECRET_ACCESS_KEY=__CHANGE_ME__

# ── AI diagnostics (optional) ────────────────────────────────
# When absent, AiDiagnosticsService falls back to deterministic
# rule-based analysis — the feature degrades, it does not break.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug                      # debug | info | warning | error
LOG_FORMAT=json                      # json | text
