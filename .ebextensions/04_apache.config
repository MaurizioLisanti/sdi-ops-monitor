files:
  "/etc/httpd/conf.d/rewrite.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      <Directory "/var/www/html">
        AllowOverride All
        Options -Indexes +FollowSymLinks
        Require all granted
      </Directory>

container_commands:
  01_enable_rewrite:
    command: "sed -i 's/AllowOverride None/AllowOverride All/g' /etc/httpd/conf/httpd.conf || true"
  02_restart_apache:
    command: "service httpd restart || true"
