# CloudWatch Logs agent + metric filter + operational alarms
# Log group: /aws/elasticbeanstalk/sdi-ops-monitor/app
# Streams: logs/error.log, logs/debug.log (CakePHP 5 standard paths)

packages:
  yum:
    amazon-cloudwatch-agent: []

files:
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "agent": {
          "run_as_user": "root"
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/app/current/logs/error.log",
                  "log_group_name": "/aws/elasticbeanstalk/sdi-ops-monitor/app",
                  "log_stream_name": "{instance_id}/error.log",
                  "timezone": "UTC"
                },
                {
                  "file_path": "/var/app/current/logs/debug.log",
                  "log_group_name": "/aws/elasticbeanstalk/sdi-ops-monitor/app",
                  "log_stream_name": "{instance_id}/debug.log",
                  "timezone": "UTC"
                }
              ]
            }
          }
        }
      }

commands:
  01_start_cloudwatch_agent:
    command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json"
    ignoreErrors: true

container_commands:
  01_ensure_log_dirs:
    command: "mkdir -p /var/app/current/logs && touch /var/app/current/logs/error.log /var/app/current/logs/debug.log && chmod 664 /var/app/current/logs/error.log /var/app/current/logs/debug.log"
    ignoreErrors: true

Resources:
  SdiOpsLogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: "/aws/elasticbeanstalk/sdi-ops-monitor/app"
      RetentionInDays: 30

  SdiOpsAlertsTopic:
    Type: AWS::SNS::Topic
    Properties:
      TopicName: sdi-ops-alerts

  SdiOpsErrorMetricFilter:
    Type: AWS::Logs::MetricFilter
    DependsOn: SdiOpsLogGroup
    Properties:
      LogGroupName: "/aws/elasticbeanstalk/sdi-ops-monitor/app"
      FilterName: sdi-ops-ErrorFilter
      FilterPattern: '{ $.level = "error" }'
      MetricTransformations:
        - MetricValue: "1"
          MetricNamespace: sdi-ops-monitor
          MetricName: ErrorCount
          DefaultValue: 0

  SdiOpsErrorRateAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: sdi-ops-ErrorRate
      AlarmDescription: "Error rate > 10 per minute for 2 consecutive periods"
      MetricName: ErrorCount
      Namespace: sdi-ops-monitor
      Statistic: Sum
      Period: 60
      EvaluationPeriods: 2
      Threshold: 10
      ComparisonOperator: GreaterThanThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - Ref: SdiOpsAlertsTopic
      OKActions:
        - Ref: SdiOpsAlertsTopic

  SdiOpsEBHealthAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: sdi-ops-EBHealth
      AlarmDescription: "EB environment health != Ok for 5 consecutive minutes"
      MetricName: EnvironmentHealth
      Namespace: AWS/ElasticBeanstalk
      Dimensions:
        - Name: EnvironmentName
          Value:
            Ref: AWSEBEnvironmentName
      Statistic: Maximum
      Period: 60
      EvaluationPeriods: 5
      Threshold: 0
      ComparisonOperator: GreaterThanThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - Ref: SdiOpsAlertsTopic
      OKActions:
        - Ref: SdiOpsAlertsTopic
